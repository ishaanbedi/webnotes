# ── Neon Postgres (the one source of truth) ─────────────────────────────
DATABASE_URL=postgres://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_POOLED=                # optional; used at runtime when set
DATABASE_URL_UNPOOLED=              # optional; used by db:migrate when set

# ── Neon Auth (managed Better Auth) ─ Console → Settings → Better Auth ──
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=            # openssl rand -base64 32

# ── Neon Realtime (optional; live sidebar + live note sync) ─────────────
#   neon realtime enable && neon env pull --service realtime
NEON_REALTIME_URL=                  # also exposed to the browser automatically (next.config.ts)
NEON_REALTIME_SECRET=
NEON_REALTIME_DB=neondb

# ── Neon Object Storage (optional; image uploads) ───────────────────────
#   neon deploy   (creates the bucket from neon.ts and writes these)
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=uploads


# Public origin for share links (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000
